# PostgreSQL connection string used by the FastAPI backend.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/worldcup

# Comma-separated list of allowed CORS origins (the Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret required (via X-API-Key header) to create/update/delete predictions.
# Reads are public. Set a strong, unique value in production. Do NOT commit the real key.
ADMIN_API_KEY=replace-with-a-strong-secret
